{%- assign f = product.metafields.custom.manual.value | default: file -%}
{%- if f -%}
<a class="gpl-manual" href="{{ f }}" target="_blank" rel="noopener">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
  {{ label | default: 'Download file' }}
</a>
{%- endif -%}

{% stylesheet %}
.gpl-manual { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0.5rem 0; padding: 0.55rem 1.1rem; border: 1px solid rgb(var(--color-foreground, 148 163 184) / 0.3); border-radius: 9px; font-size: 0.72rem; font-weight: 700; text-decoration: none; color: inherit; }
.gpl-manual svg { width: 0.9rem; height: 0.9rem; }
.gpl-manual:hover { border-color: rgb(var(--color-button, 21 128 61)); color: rgb(var(--color-button, 21 128 61)); }
{% endstylesheet %}
