<span class="gpl-origin">{{ flag | default: '' }} {{ text | default: 'Made in India' }}</span>

{% stylesheet %}
.gpl-origin {
  display: inline-flex;
  align-items: center;
  gap: 0.3rem;
  padding: 0.35rem 0.8rem;
  border: 1px solid rgb(var(--color-foreground, 148 163 184) / 0.25);
  border-radius: 999px;
  font-size: 0.65rem;
  font-weight: 700;
}
{% endstylesheet %}
