{%- assign f = product.metafields.custom.fit.value | default: fit -%}
<p class="gpl-fit">
  {%- if f == 'small' -%}
    Runs small - consider sizing up
  {%- elsif f == 'large' -%}
    Runs large - consider sizing down
  {%- else -%}
    True to size - order your usual
  {%- endif -%}
</p>

{% stylesheet %}
.gpl-fit { margin: 0.4rem 0; font-size: 0.72rem; color: rgb(var(--color-foreground, 100 116 139) / 0.85); }
{% endstylesheet %}
