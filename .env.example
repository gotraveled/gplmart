# --- Public ---
# Canonical/sitemap/Open Graph base URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://gplmart.com
NEXT_PUBLIC_ANNOUNCEMENT=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (use rzp_test_ keys first) ---
# Public id is returned to the browser to open Checkout; the secret must stay server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# --- Offer ---
# Authoritative price in paise (49900 = INR 499.00). Server-side only.
ALL_ACCESS_PRICE_PAISE=49900

# Shared password that unlocks the /access resource hub for buyers.
# Delivered to customers manually (e.g. on WhatsApp) after payment.
ACCESS_PASSWORD=

# WhatsApp number buyers are sent to after payment (country code, digits only).
NEXT_PUBLIC_WHATSAPP_NUMBER=91

# Live (non-test) checkout stays closed unless this is exactly true AND content is marked ready in /admin/settings.
CHECKOUT_LIVE_ENABLED=false


# --- Stripe (optional - international card checkout) ---
# SERVER ONLY. Secret key from the Stripe dashboard; enables a 'Pay by card - Stripe' button when the flag below is also true.
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_ENABLED=false

# --- SEO ---
# Verification token from Google Search Console (Settings > Ownership verification > HTML tag).
GOOGLE_SITE_VERIFICATION=

# --- Transactional email (optional, Resend) ---
# Sends member welcome credentials + order mail. Without it, new accounts get
# Supabase's built-in password-reset email instead.
RESEND_API_KEY=
EMAIL_FROM=GPLMart <hello@gplmart.com>

# --- Stripe webhook (optional) ---
# Signing secret from Stripe Dashboard > Developers > Webhooks (endpoint /api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
