# --- Public ---
# Canonical/sitemap/Open Graph base URL (no trailing slash)
NEXT_PUBLIC_SITE_URL=https://gplmart.com
NEXT_PUBLIC_ANNOUNCEMENT=

# --- Supabase (Project Settings > API) ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER ONLY. Never prefix with NEXT_PUBLIC_. Bypasses row-level security.
SUPABASE_SERVICE_ROLE_KEY=

# --- Razorpay (use rzp_test_ keys first) ---
# Public id is returned to the browser to open Checkout; the secret must stay server-side.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Secret you set when creating the webhook in the Razorpay dashboard
RAZORPAY_WEBHOOK_SECRET=

# --- Offer ---
# Authoritative price in paise (49900 = INR 499.00). Server-side only.
ALL_ACCESS_PRICE_PAISE=49900

# Live (non-test) checkout stays closed unless this is exactly true AND content is marked ready in /admin/settings.
CHECKOUT_LIVE_ENABLED=false
