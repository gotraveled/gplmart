<div class="gpl-collections" style="--gpl-cols: {{ section.settings.columns }}; --gpl-radius: {{ section.settings.radius }}px;">
  {%- for block in section.blocks -%}
    {%- assign collection = block.settings.collection -%}
    {%- if collection != blank -%}
      <a class="gpl-collections__card" href="{{ collection.url }}" {{ block.shopify_attributes }}>
        {%- if collection.image -%}
          {{ collection.image | image_url: width: 600 | image_tag: loading: 'lazy', alt: collection.title }}
        {%- else -%}
          {{ 'collection-1' | placeholder_svg_tag: 'gpl-collections__placeholder' }}
        {%- endif -%}
        <span class="gpl-collections__title">{{ collection.title | escape }}</span>
      </a>
    {%- endif -%}
  {%- endfor -%}
</div>

{% schema %}
{
  "name": "Collection grid",
  "settings": [
    { "type": "range", "id": "columns", "min": 2, "max": 4, "step": 1, "label": "Columns", "default": 3 },
    { "type": "range", "id": "radius", "min": 0, "max": 24, "step": 4, "unit": "px", "label": "Corner radius", "default": 12 }
  ],
  "blocks": [
    {
      "type": "collection",
      "name": "Collection",
      "settings": [{ "type": "collection", "id": "collection", "label": "Collection" }]
    }
  ],
  "max_blocks": 12,
  "presets": [{ "name": "Collection grid" }]
}
{% endschema %}

{% stylesheet %}
.gpl-collections {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 1rem;
}
@media (min-width: 750px) {
  .gpl-collections { grid-template-columns: repeat(var(--gpl-cols), 1fr); }
}
.gpl-collections__card {
  position: relative;
  display: block;
  overflow: hidden;
  border-radius: var(--gpl-radius);
  aspect-ratio: 4 / 5;
  background: rgb(var(--color-foreground, 148 163 184) / 0.12);
}
.gpl-collections__card img,
.gpl-collections__placeholder { width: 100%; height: 100%; object-fit: cover; }
.gpl-collections__title {
  position: absolute;
  inset: auto 0 0 0;
  padding: 0.75rem 1rem;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.65));
  color: #fff;
  font-weight: 600;
}
{% endstylesheet %}
