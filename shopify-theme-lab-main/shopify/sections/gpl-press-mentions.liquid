{%- assign pubs = section.settings.names | split: ',' -%}
<div class="gpl-press">
  {%- if section.settings.heading != blank -%}
    <p class="gpl-press__eyebrow">{{ section.settings.heading }}</p>
  {%- endif -%}
  <ul class="gpl-press__list">
    {%- for p in pubs -%}
      <li>{{ p | strip }}</li>
    {%- endfor -%}
  </ul>
</div>

{% schema %}
{
  "name": "Press mentions",
  "settings": [
    { "type": "text", "id": "heading", "label": "Eyebrow", "default": "As featured in" },
    { "type": "text", "id": "names", "label": "Publications (comma separated)", "default": "Vogue India, Economic Times, Mint Lifestyle, YourStory" }
  ],
  "presets": [{ "name": "Press mentions" }]
}
{% endschema %}

{% stylesheet %}
.gpl-press { padding: 1.25rem 0; text-align: center; }
.gpl-press__eyebrow {
  margin: 0 0 0.9rem;
  font-size: 0.65rem;
  font-weight: 700;
  letter-spacing: 0.2em;
  text-transform: uppercase;
  color: rgb(var(--color-foreground, 100 116 139) / 0.75);
}
.gpl-press__list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 0.75rem 2rem;
  margin: 0;
  padding: 0;
  list-style: none;
}
.gpl-press__list li {
  font-family: Georgia, 'Times New Roman', serif;
  font-size: 0.95rem;
  font-style: italic;
  color: rgb(var(--color-foreground, 100 116 139) / 0.8);
}
{% endstylesheet %}
