{%- comment -%}
  Renders a short benefit list.
  Accepts: benefits (string, items separated by "|"), accent (colour, optional)
{%- endcomment -%}
{%- assign items = benefits | split: '|' -%}
{%- if items.size > 0 -%}
  <ul class="gpl-benefits gpl-benefits--check" style="--gpl-accent: {{ accent | default: '#15803d' }};">
    {%- for item in items -%}
      <li>{{ item | strip | escape }}</li>
    {%- endfor -%}
  </ul>
{%- endif -%}

{% stylesheet %}
.gpl-benefits {
  list-style: none;
  margin: 1rem 0;
  padding: 0;
  display: grid;
  gap: 0.5rem;
}
.gpl-benefits li {
  display: flex;
  gap: 0.6rem;
  align-items: baseline;
}
.gpl-benefits li::before {
  content: "\2713";
  color: var(--gpl-accent);
  font-weight: 700;
}
{% endstylesheet %}
