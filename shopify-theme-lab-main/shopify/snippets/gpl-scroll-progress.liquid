<div class="gpl-progress" data-gpl-progress aria-hidden="true"><span class="gpl-progress__fill"></span></div>

{% stylesheet %}
.gpl-progress {
  position: fixed;
  inset: 0 0 auto 0;
  height: 3px;
  z-index: 70;
  pointer-events: none;
}
.gpl-progress__fill {
  display: block;
  height: 100%;
  width: 0%;
  background: #c8f542;
  transition: width 0.05s linear;
}
{% endstylesheet %}

{% javascript %}
(function () {
  const fill = document.querySelector('.gpl-progress__fill');
  if (!fill) return;
  const update = () => {
    const max = document.documentElement.scrollHeight - window.innerHeight;
    fill.style.width = max > 0 ? ((window.scrollY / max) * 100).toFixed(1) + '%' : '0%';
  };
  window.addEventListener('scroll', update, { passive: true });
  window.addEventListener('resize', update);
  update();
})();
{% endjavascript %}
