{%- comment -%} Only publish claims that match your real store policies. {%- endcomment -%}
<ul class="gpl-trust gpl-trust--row">
    <li class="gpl-trust__item">
      <span class="gpl-trust__icon gpl-trust__icon--lock" aria-hidden="true"></span>
      <strong>Secure payment</strong>
      <span>Pay with the methods enabled in your Shopify checkout.</span>
    </li>
    <li class="gpl-trust__item">
      <span class="gpl-trust__icon gpl-trust__icon--return" aria-hidden="true"></span>
      <strong>Returns</strong>
      <span>Describe your actual returns window here.</span>
    </li>
    <li class="gpl-trust__item">
      <span class="gpl-trust__icon gpl-trust__icon--chat" aria-hidden="true"></span>
      <strong>Support</strong>
      <span>Tell customers how to reach you.</span>
    </li>
</ul>

{% stylesheet %}
.gpl-trust {
  list-style: none;
  margin: 1.5rem 0;
  padding: 0;
  display: flex;
  flex-wrap: wrap;
  gap: 1rem;
}
.gpl-trust__item {
  display: grid;
  gap: 0.25rem;
  flex: 1 1 14rem;
  padding: 1rem;
  border: 1px solid rgb(var(--color-foreground, 213 220 203) / 0.35);
  border-radius: 12px;
  font-size: 0.875rem;
}
.gpl-trust__icon {
  width: 1.5rem;
  height: 1.5rem;
  border-radius: 6px;
  background: rgb(var(--color-background, 11 18 32));
}
{% endstylesheet %}
