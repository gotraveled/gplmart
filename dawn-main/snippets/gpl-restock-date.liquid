{% stylesheet %}
.gpl-restock { display: flex; align-items: center; gap: 0.45rem; margin: 0.5rem 0; font-size: 0.72rem; color: rgb(var(--color-foreground, 100 116 139) / 0.85); }
.gpl-restock svg { width: 0.85rem; height: 0.85rem; color: rgb(var(--color-button, 21 128 61)); }
.gpl-restock b { font-weight: 800; }
{% endstylesheet %}
