<div class="gpl-author">
  <div class="gpl-author__avatar">{{ name | slice: 0 }}</div>
  <div>
    <p class="gpl-author__name">{{ name | default: article.author | default: 'Team' }}</p>
    <p class="gpl-author__bio">{{ bio | default: '' }}</p>
  </div>
</div>

{% stylesheet %}
.gpl-author { display: flex; align-items: center; gap: 0.9rem; margin: 2rem 0; padding: 1.1rem; border: 1px solid rgb(var(--color-foreground, 148 163 184) / 0.2); border-radius: 12px; }
.gpl-author__avatar {
  display: grid;
  place-items: center;
  width: 3rem;
  height: 3rem;
  border-radius: 999px;
  background: rgb(var(--color-button, 21 128 61));
  color: #fff;
  font-size: 1.1rem;
  font-weight: 800;
  flex-shrink: 0;
}
.gpl-author__name { margin: 0; font-size: 0.82rem; font-weight: 800; }
.gpl-author__bio { margin: 0.25rem 0 0; font-size: 0.72rem; color: rgb(var(--color-foreground, 100 116 139) / 0.8); }
{% endstylesheet %}
