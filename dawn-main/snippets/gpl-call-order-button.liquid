<a class="gpl-call" href="tel:{{ phone | remove: ' ' }}">
  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72c.13.96.36 1.9.7 2.81a2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45c.91.34 1.85.57 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
  {{ label | default: 'Call to order' }} - {{ phone }}
</a>

{% stylesheet %}
.gpl-call { display: inline-flex; align-items: center; gap: 0.5rem; margin: 0.5rem 0; padding: 0.6rem 1.25rem; border: 1px solid rgb(var(--color-foreground, 148 163 184) / 0.3); border-radius: 999px; font-size: 0.75rem; font-weight: 700; text-decoration: none; color: inherit; }
.gpl-call svg { width: 0.9rem; height: 0.9rem; }
.gpl-call:hover { border-color: rgb(var(--color-button, 21 128 61)); color: rgb(var(--color-button, 21 128 61)); }
{% endstylesheet %}
