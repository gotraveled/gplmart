{%- assign unit_qty = qty | plus: 0 -%}
{%- if unit_qty > 0 -%}
<p class="gpl-unit">
  {{ product.selected_or_first_available_variant.price | divided_by: unit_qty | money }} / {{ unit | default: 'unit' }}
</p>
{%- endif -%}

{% stylesheet %}
.gpl-unit { margin: 0.2rem 0 0; font-size: 0.72rem; color: rgb(var(--color-foreground, 100 116 139) / 0.75); }
{% endstylesheet %}
